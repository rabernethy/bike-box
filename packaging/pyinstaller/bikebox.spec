# PyInstaller spec for Bike Box.  Build from the repo root:
#     pyinstaller packaging/pyinstaller/bikebox.spec
# Produces a one-folder app in dist/BikeBox (BikeBox.app on macOS).
import sys
from pathlib import Path

from PyInstaller.utils.hooks import collect_data_files, collect_submodules

ROOT = Path(SPECPATH).resolve().parents[1]     # repo root (SPECPATH is this file's dir)
APP = "BikeBox"

# bundle the data (templates, libraries, parts catalog) under bikebox/data so the
# runtime's Path(__file__).parents[1] / "data" resolves inside the frozen app
datas = [(str(ROOT / "bikebox" / "data"), "bikebox/data")]
datas += collect_data_files("pyqtgraph")       # 3-D clearance viewer resources

# pyqtgraph.opengl and PyOpenGL import platform backends dynamically
hidden = (collect_submodules("bikebox") + ["defusedxml", "defusedxml.ElementTree"]
          + collect_submodules("pyqtgraph.opengl") + collect_submodules("OpenGL"))

# The app uses only QtCore/QtGui/QtWidgets/QtPrintSupport (+ QtOpenGL[Widgets] via
# pyqtgraph for the 3-D view).  Exclude the rest of the Qt modules so their Qt6
# shared libraries (QtNetwork pulls the whole TLS/OpenSSL stack, Qml/Quick/3D and
# WebEngine are huge) are not bundled.  Keep QtDBus/QtSvg/QtXml -- small and used
# by Qt's own Linux desktop integration / icon handling.
_UNUSED_QT = [
    "QtNetwork", "QtQml", "QtQuick", "QtQuick3D", "QtQuickWidgets", "QtQuickControls2",
    "QtMultimedia", "QtMultimediaWidgets", "QtSql", "QtTest", "QtBluetooth", "QtNfc",
    "QtPositioning", "QtLocation", "QtSerialPort", "QtSensors", "QtWebChannel",
    "QtWebSockets", "QtCharts", "QtDataVisualization", "QtDesigner", "QtPdf",
    "QtPdfWidgets", "QtHelp", "QtRemoteObjects", "QtTextToSpeech", "QtSpatialAudio",
    "QtWebEngineCore", "QtWebEngineWidgets", "QtWebEngineQuick",
    "Qt3DCore", "Qt3DRender", "Qt3DInput", "Qt3DLogic", "Qt3DAnimation", "Qt3DExtras",
]
# Development / test packages that are never imported by the frozen app but can be
# dragged in from a dev machine's site-packages (twisted -> OpenSSL -> cryptography,
# pytest, pygame, ...).  Harmless on CI (not installed there), belt-and-suspenders.
_DEV = ["pytest", "_pytest", "twisted", "OpenSSL", "cryptography", "pygame", "IPython",
        "jedi", "sphinx", "nose", "pytest_subtests"]

# platform icon, generated by make_icons.py before the build (optional)
icon = None
for cand in ("bikebox.icns", "bikebox.ico"):
    p = Path(SPECPATH) / cand
    if p.exists():
        icon = str(p)
        break

a = Analysis(
    [str(Path(SPECPATH) / "entry.py")],
    pathex=[str(ROOT)],
    datas=datas,
    hiddenimports=hidden,
    hookspath=[],
    excludes=(["tkinter", "PySide6", "PyQt5", "scipy", "matplotlib", "pandas", "PIL"]
              + [f"PyQt6.{m}" for m in _UNUSED_QT] + _DEV),
    noarchive=False,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz, a.scripts, [],
    exclude_binaries=True,
    name=APP,
    console=False,               # GUI app, no console window on Windows
    icon=icon,
)
coll = COLLECT(exe, a.binaries, a.datas, name=APP)

if sys.platform == "darwin":
    app = BUNDLE(
        coll,
        name=f"{APP}.app",
        icon=icon,
        bundle_identifier="org.bikebox.app",
        info_plist={
            "CFBundleDisplayName": "Bike Box",
            "CFBundleName": "Bike Box",
            "NSHighResolutionCapable": True,
            "CFBundleDocumentTypes": [
                {"CFBundleTypeName": "Bike Box design", "CFBundleTypeExtensions": ["bikebox"],
                 "CFBundleTypeRole": "Editor"},
                {"CFBundleTypeName": "BikeCAD design", "CFBundleTypeExtensions": ["bcad"],
                 "CFBundleTypeRole": "Viewer"},
            ],
        },
    )
